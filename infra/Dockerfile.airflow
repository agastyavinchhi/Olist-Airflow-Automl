# Teaching Airflow image: official Airflow + pandas/sklearn for baseline prep,
# plus Postgres + plotting libs for the olist_pipeline DAG.
FROM apache/airflow:2.10.4-python3.11

USER root
RUN apt-get update \
  && apt-get install -y --no-install-recommends gcc g++ \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

USER airflow
# pandas <2.2: pandas 2.2+ needs SQLAlchemy 2 for to_sql/read_sql, but Airflow 2.10
# pins SQLAlchemy 1.4. psycopg2 + the postgres provider ship with the base image.
RUN pip install --no-cache-dir \
  "pandas>=2.0,<2.2" \
  "scikit-learn>=1.3" \
  "numpy>=1.26" \
  "matplotlib>=3.8"
